{
  "name": "opencode-rules-md",
  "version": "0.10.0",
  "description": "OpenCode plugin that discovers and injects markdown rules into system prompts",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "oc-plugin": [
    "server",
    "tui"
  ],
  "bin": {
    "omd": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsc && bun scripts/build-tui.mjs && bun scripts/build-cli.mjs",
    "build:cli": "bun scripts/build-cli.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src tui",
    "format": "prettier --write 'src/**/*.ts' 'tui/**/*.tsx' 'tui/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tui/**/*.tsx' 'tui/**/*.ts'",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "packageManager": "pnpm@11.12.0",
  "keywords": [
    "opencode",
    "plugin",
    "rules",
    "system-prompt",
    "typescript"
  ],
  "author": "MetalbolicX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetalbolicX/opencode-rules-md.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/opencode-rules-md/issues"
  },
  "files": [
    "dist",
    "dist/cli.mjs",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/test-fixtures.*",
    "!dist/**/api-surface.typecheck.*",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/test-fixtures.ts",
    "!src/api-surface.typecheck.ts",
    "tui/",
    "!tui/**/*.test.ts",
    "!tui/**/*.test.tsx",
    "!tui/**/*.spec.ts",
    "!tui/**/*.spec.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.3.9",
    "@opencode-ai/sdk": "^1.3.9"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.2",
    "@opencode-ai/sdk": "^1.18.2",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opentui/core": "^0.4.3",
    "@opentui/solid": "^0.4.3",
    "minimatch": "^10.2.5",
    "solid-js": "^1.9.14",
    "yaml": "^2.9.0"
  }
}
